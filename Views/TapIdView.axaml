<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicPaymentApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ElectronicPaymentApp.Views.TapIdView"
             x:DataType="vm:TapIdViewModel">

    <UserControl.Styles>
        <!-- Discreet pill-shaped text button in the footer. -->
        <Style Selector="Button.back-home">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Hover / pressed / keyboard focus: soft tinted background and darker content. -->
        <Style Selector="Button.back-home:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.back-home:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>
        <Style Selector="Button.back-home:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BackgroundBrush}" Padding="32">
        <Grid RowDefinitions="*,Auto">

            <!-- Centered group: contactless icon + message -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Contactless symbol: four arcs radiating from the left, drawn on a 24x24 grid. -->
                <Viewbox Width="76" Height="76" Margin="0,0,0,24">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{DynamicResource PrimaryContainerBrush}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              Data="M5.83,9.17 A4,4 0 0 1 5.83,14.83
                                    M8.66,6.34 A8,8 0 0 1 8.66,17.66
                                    M11.49,3.51 A12,12 0 0 1 11.49,20.49
                                    M14.31,0.69 A16,16 0 0 1 14.31,23.31" />
                    </Canvas>
                </Viewbox>

                <TextBlock Text="Waiting to tap your ID on the reader..."
                           FontSize="24"
                           FontWeight="Medium"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OnSurfaceBrush}" />
            </StackPanel>

            <!-- Discreet bottom button -->
            <Button Grid.Row="1"
                    Classes="back-home"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8"
                    Command="{Binding BackToHomeCommand}"
                    AutomationProperties.Name="Back to Home">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.ArrowBack}"
                              Width="18" Height="18"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Back to Home" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </Grid>
    </Border>
</UserControl>